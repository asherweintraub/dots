{
	"$schema": "https://opencode.ai/config.json",
	"provider": {
		"ollama": {
			"models": {
				"glm-4.7-flash": {
					"_launch": true,
					"limit": {
						"context": 202752,
						"output": 131072
					},
					"name": "glm-4.7-flash"
				},
				"glm-5:cloud": {
					"_launch": true,
					"limit": {
						"context": 202752,
						"output": 131072
					},
					"name": "glm-5:cloud"
				}
			},
			"name": "Ollama",
			"npm": "@ai-sdk/openai-compatible",
			"options": {
				"baseURL": "http://127.0.0.1:11434/v1"
			}
		}
	},
	"permission": {
		"edit": "ask",
		"bash": "ask"
	},
	"mcp": {
		"Astro docs": {
			"enabled": true,
			"type": "remote",
			"url": "https://mcp.docs.astro.build/mcp"
		},
		"supabase": {
			"enabled": true,
			"type": "remote",
			"url": "https://mcp.supabase.com/mcp"
		},
		"context7": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"enabled": true,
			"headers": {
				"CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
			}
		}
	}
}
