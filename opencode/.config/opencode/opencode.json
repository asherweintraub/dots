{
	"$schema": "https://opencode.ai/config.json",
	"plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],

	"provider": {
		"ollama": {
			"models": {
				"glm-4.7-flash": {
					"_launch": true,
					"limit": {
						"context": 202752,
						"output": 131072
					},
					"name": "glm-4.7-flash"
				},
				"glm-5:cloud": {
					"_launch": true,
					"limit": {
						"context": 202752,
						"output": 131072
					},
					"name": "glm-5:cloud"
				}
			},
			"name": "Ollama",
			"npm": "@ai-sdk/openai-compatible",
			"options": {
				"baseURL": "http://127.0.0.1:11434/v1"
			}
		}
	},
	"permission": {
		"edit": "ask",
		"bash": {
			"*": "ask",
			"rg *": "allow",
			"grep *": "allow",
			"ls *": "allow",
			"find *": "allow",
			"head *": "allow",
			"cat *": "allow",
			"echo *": "allow"
		}
	},
	"mcp": {
		"Astro docs": {
			"enabled": true,
			"type": "remote",
			"url": "https://mcp.docs.astro.build/mcp"
		},
		"supabase": {
			"enabled": true,
			"type": "remote",
			"url": "https://mcp.supabase.com/mcp"
		},
		"netlify": {
			"enabled": true,
			"type": "local",
			"command": ["npx", "-y", "@netlify/mcp"],
			"env": {
				"NETLIFY_AUTH_TOKEN": "{env:NETLIFY_PAT}"
			}
		},
		"context7": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"enabled": true,
			"headers": {
				"CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
			}
		}
	}
}
