# https://ghostty.org/docs/config/reference

macos-option-as-alt = true

# theme
theme = light:Monokai Pro Light,dark:Monokai Pro Spectrum

# font (bold/italic variants are auto-selected, no config needed)
font-family = SF Mono
font-size = 14

# window
window-padding-x = 4
window-padding-y = 4
macos-titlebar-style = transparent

# cursor (no-cursor stops shell integration forcing a bar at the prompt)
cursor-style = block
shell-integration-features = no-cursor

# other
quit-after-last-window-closed = true
mouse-hide-while-typing = true
